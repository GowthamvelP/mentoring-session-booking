# Mentoring Session Booking — Environment Variables
# Copy this file to .env and update values as needed

# Rails secret key (generate with: rails secret)
SECRET_KEY_BASE=change_me_to_a_64_char_hex_string

# Database (used by docker-compose)
POSTGRES_USER=mentoring
POSTGRES_PASSWORD=mentoring
POSTGRES_DB=mentoring_development

# Redis
REDIS_URL=redis://redis:6379/0

# Rails
RAILS_ENV=development
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true

# Frontend
VITE_API_URL=http://localhost:3000/api/v1
